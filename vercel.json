{
  "headers": [
    {
      "source": "/miniapp/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ],
  "functions": {
    "api/telegram.ts": {
      "maxDuration": 30
    },
    "api/miniapp.ts": {
      "maxDuration": 30
    }
  }
}

