# Продовый токен (@BotFather). На Vercel — только он; USE_DEV_BOT не задавать.
BOT_TOKEN=

# Локальная разработка вторым ботом (не пересекается с прод-вебхуком)
USE_DEV_BOT=true
BOT_TOKEN_DEV=

WHITELIST_BYPASS=false
ROLE_ALWAYS_SWITCH_IDS=
ROLE_LOCK_FIRST_IDS=

# Локально: SQLite data/bot.db даже если в .env есть POSTGRES_URL
DEV_USE_SQLITE=true

# POSTGRES_URL=
# DATABASE_URL=

# Telegram Mini App: публичный https URL. На Vercel после деплоя: https://<project>.vercel.app/miniapp/ (файл в public/miniapp/). Домен добавить в @BotFather.
# Профиль в приложении запрашивает GET /api/miniapp-config?initData=... (тот же BOT_TOKEN для проверки подписи).
# MINI_APP_URL=https://example.com/miniapp/
